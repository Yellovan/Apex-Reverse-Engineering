# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Secrets / local config
.env
*.local

# output/csv/ holds the structured trade JSON database (scripts/batch_parse.py
# output) — that's a research deliverable, not a build artifact, so it's
# tracked. Graphs/reports stay ignored since those are throwaway visual
# exports regenerable from the same data.
output/graphs/*
!output/graphs/.gitkeep
output/reports/*
!output/reports/.gitkeep

# Videos are large; track via Git LFS if added (see .gitattributes), never commit raw temp exports
data/videos/*.tmp

# Compiled MQL5 binaries -- build artifacts, not source
ea_drafts/*.ex5
